# Altium Migration Assistant configuration.
# Copy this file to .env. Never commit .env because it contains access tokens.

# JSON array of source workspaces. You may add as many sources as needed.
# id: stable local identifier used by ACTIVE_SOURCE_WORKSPACE and cache file names.
# name: label displayed in the interface.
# apiUrl: Altium 365 GraphQL endpoint.
# filesUploadUrl: optional Files Service upload endpoint; derived from apiUrl when empty.
# accessToken: token belonging to this source workspace, normally read-only.
ALTIUM_SOURCE_WORKSPACES_JSON=[{"id":"ZPCE","name":"ZPCE","apiUrl":"https://source.example.altium.com/api/graphql","filesUploadUrl":"","accessToken":"replace_with_source_token"}]

# id of the source selected when the application starts.
ACTIVE_SOURCE_WORKSPACE=ZPCE

# Single destination workspace used for all migrations.
# The destination token requires library read/write and release permissions.
ALTIUM_TARGET_WORKSPACE_JSON={"id":"GLOBAL_FLUIDRA","name":"Global Fluidra","apiUrl":"https://target.example.altium.com/api/graphql","filesUploadUrl":"","accessToken":"replace_with_target_token"}

# true: add certificates trusted by Windows to Node.js trust roots.
# Keep enabled on corporate networks using an internal TLS authority.
ALTIUM_USE_SYSTEM_CA=true

# Validity period of persisted symbol, footprint and component lists, in hours.
ALTIUM_CACHE_TTL_HOURS=168

# Optional local Fluidra DXP Bridge hosted inside Altium Designer.
# URL must stay on loopback unless the bridge security model is deliberately changed.
ALTIUM_DESIGNER_BRIDGE_URL=http://127.0.0.1:4174

# Shared Bearer token used by this app and bridge.settings.json.
# Use a random value of at least 24 characters.
ALTIUM_DESIGNER_BRIDGE_TOKEN=replace_with_a_long_random_local_token

# Local HTTP port of the migration application.
PORT=4173

# Legacy variables are still read for migration from older installations:
# ZPCE_ACCESS_TOKEN, ZPCE_API_URL, ZPCE_FILES_UPLOAD_URL,
# GLOBAL_FLUIDRA_ACCESS_TOKEN, GLOBAL_FLUIDRA_API_URL,
# GLOBAL_FLUIDRA_FILES_UPLOAD_URL and ALTIUM_ACCESS_TOKEN.
